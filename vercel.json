{
 "version": 2,
 "builds": [
   {
     "src": "*.html",
     "use": "@vercel/static"
   },
   {
     "src": "maps/*.html",
     "use": "@vercel/static"
   }
 ],
 "routes": [
   {
     "src": "/maps",
     "dest": "/maps/index.html"
   },
   {
     "src": "/maps/(.*)",
     "dest": "/maps/$1"
   },
   {
     "src": "/(.*)",
     "dest": "/$1"
   }
 ]
}
